{# The Bitlane screen: the React app (screen/, built into
   admin/view/javascript/bitlane) mounts on #bitlane-admin and reads its
   settings from data-config, escaped by the controller. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="container-fluid pt-3">
    {% if problem %}
      <div class="alert alert-danger"><strong>{{ text_problem }}</strong><br>{{ problem }}</div>
    {% else %}
      <div id="bitlane-admin" data-config="{{ config }}"></div>
    {% endif %}
  </div>
</div>
{{ footer }}
